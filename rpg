local function createESPForPlayer(targetPlayer)
	if espData[targetPlayer] then return end
	
	local espFolder = Instance.new("Folder")
	espFolder.Name = "ESP_" .. targetPlayer.Name
	espFolder.Parent = screenGui
	
	local topLine = Instance.new("Frame")
	topLine.BackgroundColor3 = espColor
	topLine.BorderSizePixel = 0
	topLine.ZIndex = 10
	topLine.Parent = espFolder
	
	local bottomLine = Instance.new("Frame")
	bottomLine.BackgroundColor3 = espColor
	bottomLine.BorderSizePixel = 0
	bottomLine.ZIndex = 10
	bottomLine.Parent = espFolder
	
	local leftLine = Instance.new("Frame")
	leftLine.BackgroundColor3 = espColor
	leftLine.BorderSizePixel = 0
	leftLine.ZIndex = 10
	leftLine.Parent = espFolder
	
	local rightLine = Instance.new("Frame")
	rightLine.BackgroundColor3 = espColor
	rightLine.BorderSizePixel = 0
	rightLine.ZIndex = 10
	rightLine.Parent = espFolder
	
	local tracerLine = Instance.new("Frame")
	tracerLine.BackgroundColor3 = tracerColor
	tracerLine.BorderSizePixel = 0
	tracerLine.ZIndex = 9
	tracerLine.Parent = espFolder
	
	espData[targetPlayer] = {
		folder = espFolder,
		topLine = topLine,
		bottomLine = bottomLine,
		leftLine = leftLine,
		rightLine = rightLine,
		tracer = tracerLine
	}
end

local function removeESPForPlayer(targetPlayer)
	if espData[targetPlayer] then
		espData[targetPlayer].folder:Destroy()
		espData[targetPlayer] = nil
	end
end

local function updateESP()
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player then
			local character = targetPlayer.Character
			local humanoid = character and character:FindFirstChild("Humanoid")
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			
			if character and humanoid and humanoid.Health > 0 and rootPart then
				if not espData[targetPlayer] then
					createESPForPlayer(targetPlayer)
				end
				
				local data = espData[targetPlayer]
				local head = character:FindFirstChild("Head")
				local leftFoot = character:FindFirstChild("LeftFoot") or character:FindFirstChild("Left Leg")
				local rightFoot = character:FindFirstChild("RightFoot") or character:FindFirstChild("Right Leg")
				
				if head and (leftFoot or rightFoot) then
					local headPos = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
					local footPos
					
					if leftFoot and rightFoot then
						local leftFootBottom = leftFoot.Position - Vector3.new(0, leftFoot.Size.Y / 2, 0)
						local rightFootBottom = rightFoot.Position - Vector3.new(0, rightFoot.Size.Y / 2, 0)
						footPos = (leftFootBottom + rightFootBottom) / 2
					elseif leftFoot then
						footPos = leftFoot.Position - Vector3.new(0, leftFoot.Size.Y / 2, 0)
					else
						footPos = rightFoot.Position - Vector3.new(0, rightFoot.Size.Y / 2, 0)
					end
					
					local headScreenPos, headOnScreen = camera:WorldToViewportPoint(headPos)
					local footScreenPos, footOnScreen = camera:WorldToViewportPoint(footPos)
					local rootScreenPos, rootOnScreen = camera:WorldToViewportPoint(rootPart.Position)
					
					if headOnScreen and footOnScreen and headScreenPos.Z > 0 and footScreenPos.Z > 0 then
						local height = math.abs(headScreenPos.Y - footScreenPos.Y)
						local width = height / 2
						local centerX = rootScreenPos.X
						local topY = headScreenPos.Y
						local bottomY = footScreenPos.Y
						
						data.topLine.Visible = espEnabled
						data.bottomLine.Visible = espEnabled
						data.leftLine.Visible = espEnabled
						data.rightLine.Visible = espEnabled
						data.tracer.Visible = tracersEnabled
						
						if espEnabled then
							data.topLine.Size = UDim2.new(0, width, 0, 2)
							data.topLine.Position = UDim2.new(0, centerX - width / 2, 0, topY)
							data.bottomLine.Size = UDim2.new(0, width, 0, 2)
							data.bottomLine.Position = UDim2.new(0, centerX - width / 2, 0, bottomY)
							data.leftLine.Size = UDim2.new(0, 2, 0, height)
							data.leftLine.Position = UDim2.new(0, centerX - width / 2, 0, topY)
							data.rightLine.Size = UDim2.new(0, 2, 0, height)
							data.rightLine.Position = UDim2.new(0, centerX + width / 2, 0, topY)
						end
						
						if tracersEnabled then
							local startX = camera.ViewportSize.X / 2
							local startY = camera.ViewportSize.Y
							local endX = footScreenPos.X
							local endY = footScreenPos.Y
							
							local midX = (startX + endX) / 2
							local midY = (startY + endY) / 2
							
							local deltaX = endX - startX
							local deltaY = endY - startY
							local distance = math.sqrt(deltaX * deltaX + deltaY * deltaY)
							local angle = math.deg(math.atan2(deltaY, deltaX))
							
							data.tracer.Size = UDim2.new(0, distance, 0, 2)
							data.tracer.Position = UDim2.new(0, midX, 0, midY)
							data.tracer.AnchorPoint = Vector2.new(0.5, 0.5)
							data.tracer.Rotation = angle
						end
					else
						data.topLine.Visible = false
						data.bottomLine.Visible = false
						data.leftLine.Visible = false
						data.rightLine.Visible = false
						data.tracer.Visible = false
					end
				end
			else
				removeESPForPlayer(targetPlayer)
			end
		end
	end
end

