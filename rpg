-- Kill switch
local function killSwitch()
	for _, conn in ipairs(connections) do
		if conn and conn.Disconnect then conn:Disconnect() end
	end
	for targetPlayer, data in pairs(espData) do
		if data and data.folder then data.folder:Destroy() end
	end
	for _, obj in ipairs(objectsToCleanup) do
		if obj and obj.Parent then obj:Destroy() end
	end
	print("kill switch")
end

closeButton.MouseButton1Click:Connect(killSwitch)

closeButton.MouseEnter:Connect(function()
	TweenService:Create(closeButton, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 100, 100)}):Play()
end)

