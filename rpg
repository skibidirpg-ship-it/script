		label.TextColor3 = Color3.fromRGB(240, 240, 245)
		label.TextSize = 12
		label.Font = Enum.Font.GothamBold
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.ZIndex = 51
		label.Parent = sliderFrame
		
		local valueLabel = Instance.new("TextLabel")
		valueLabel.Size = UDim2.new(0, 35, 1, 0)
		valueLabel.Position = UDim2.new(1, -35, 0, 0)
		valueLabel.BackgroundTransparency = 1
		valueLabel.Text = tostring(defaultVal)
		valueLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
		valueLabel.TextSize = 11
		valueLabel.Font = Enum.Font.Gotham
		valueLabel.TextXAlignment = Enum.TextXAlignment.Right
		valueLabel.ZIndex = 51
		valueLabel.Parent = sliderFrame
		
		local sliderBg = Instance.new("Frame")
		sliderBg.Size = UDim2.new(1, -60, 0, 8)
		sliderBg.Position = UDim2.new(0, 25, 0.5, -4)
		sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		sliderBg.BorderSizePixel = 0
		sliderBg.ZIndex = 51
		sliderBg.Parent = sliderFrame
		
		local sliderCorner = Instance.new("UICorner")
		sliderCorner.CornerRadius = UDim.new(1, 0)
		sliderCorner.Parent = sliderBg
		
		-- Color gradient for slider
		local sliderGradient = Instance.new("UIGradient")
		if colorName == "R" then
			sliderGradient.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, Color3.fromRGB(0, currentG, currentB)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, currentG, currentB))
			}
		elseif colorName == "G" then
			sliderGradient.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, Color3.fromRGB(currentR, 0, currentB)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(currentR, 255, currentB))
			}
		else
			sliderGradient.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, Color3.fromRGB(currentR, currentG, 0)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(currentR, currentG, 255))
			}
		end
		sliderGradient.Parent = sliderBg
		
		local sliderButton = Instance.new("TextButton")
		sliderButton.Size = UDim2.new(0, 16, 0, 16)
		sliderButton.Position = UDim2.new(defaultVal / 255, -8, 0.5, -8)
		sliderButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		sliderButton.BorderSizePixel = 0
		sliderButton.Text = ""
		sliderButton.ZIndex = 52
		sliderButton.Parent = sliderBg
		
		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(1, 0)
		btnCorner.Parent = sliderButton
		
		local btnStroke = Instance.new("UIStroke")
		btnStroke.Color = Color3.fromRGB(138, 43, 226)
		btnStroke.Thickness = 2
		btnStroke.Parent = sliderButton
		
		local draggingSlider = false
		
		local function updateSlider(input)
			local relativeX = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
			local value = math.floor(relativeX * 255)
			valueLabel.Text = tostring(value)
			sliderButton.Position = UDim2.new(relativeX, -8, 0.5, -8)
			
			if colorName == "R" then
				currentR = value
			elseif colorName == "G" then
				currentG = value
			else
				currentB = value
			end
			
			if updateCallback then
				updateCallback(currentR, currentG, currentB)
			end
		end
		
		local conn1 = sliderButton.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
			end
		end)
		table.insert(connections, conn1)
		
		local conn2 = sliderButton.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = false
			end
		end)
		table.insert(connections, conn2)
		
		local conn3 = sliderBg.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
