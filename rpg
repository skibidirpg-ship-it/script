tabBar.BorderSizePixel = 0
tabBar.Parent = mainFrame

local tabs = {"Visuals", "Player", "Settings"}
local currentTab = "Visuals"
local tabButtons = {}
local tabWidth = 280 / #tabs

for i, tabName in ipairs(tabs) do
	local tabButton = Instance.new("TextButton")
	tabButton.Size = UDim2.new(0, tabWidth, 1, 0)
	tabButton.Position = UDim2.new(0, (i - 1) * tabWidth, 0, 0)
	tabButton.BackgroundColor3 = tabName == currentTab and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(26, 26, 32)
	tabButton.BackgroundTransparency = tabName == currentTab and 0 or 1
	tabButton.BorderSizePixel = 0
	tabButton.Text = tabName
	tabButton.TextColor3 = tabName == currentTab and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 170)
	tabButton.TextSize = 12
	tabButton.Font = Enum.Font.GothamBold
	tabButton.Parent = tabBar
	
	tabButtons[tabName] = tabButton
	
	-- Tab underline indicator
	local indicator = Instance.new("Frame")
	indicator.Name = "Indicator"
	indicator.Size = UDim2.new(1, -10, 0, 2)
	indicator.Position = UDim2.new(0, 5, 1, -2)
	indicator.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
	indicator.BorderSizePixel = 0
	indicator.Visible = (tabName == currentTab)
	indicator.Parent = tabButton
	
	local conn = tabButton.MouseButton1Click:Connect(function()
		for name, btn in pairs(tabButtons) do
			TweenService:Create(btn, TweenInfo.new(0.3, Enum.EasingStyle.Quad), 
				{BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(160, 160, 170)}):Play()
			local ind = btn:FindFirstChild("Indicator")
			if ind then ind.Visible = false end
		end
		
		TweenService:Create(tabButton, TweenInfo.new(0.3, Enum.EasingStyle.Quad), 
			{BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(138, 43, 226), 
			TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		indicator.Visible = true
		currentTab = tabName
		
		for _, content in pairs(mainFrame:GetChildren()) do
			if content:IsA("ScrollingFrame") then
				content.Visible = (content.Name == tabName .. "Content")
			end
		end
	end)
	table.insert(connections, conn)
	
	tabButton.MouseEnter:Connect(function()
		if currentTab ~= tabName then
			TweenService:Create(tabButton, TweenInfo.new(0.2), 
				{TextColor3 = Color3.fromRGB(220, 220, 230)}):Play()
		end
	end)
	
	tabButton.MouseLeave:Connect(function()
		if currentTab ~= tabName then
			TweenService:Create(tabButton, TweenInfo.new(0.2), 
				{TextColor3 = Color3.fromRGB(160, 160, 170)}):Play()
		end
	end)
end

-- Content area
local function createTabContent(tabName)
	local scrollFrame = Instance.new("ScrollingFrame")
	scrollFrame.Name = tabName .. "Content"
	scrollFrame.Size = UDim2.new(1, -20, 1, -90)
	scrollFrame.Position = UDim2.new(0, 10, 0, 80)
	scrollFrame.BackgroundTransparency = 1
	scrollFrame.BorderSizePixel = 0
	scrollFrame.ScrollBarThickness = 5
	scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(138, 43, 226)
	scrollFrame.ScrollBarImageTransparency = 0.3
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	scrollFrame.Visible = (tabName == currentTab)
	scrollFrame.Parent = mainFrame
	
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 10)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = scrollFrame
	
	local conn = listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 15)
	end)
	table.insert(connections, conn)
	
	return scrollFrame
end

