	corner.Parent = btnFrame
	
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(1, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0.9, 0.9, 0.9))
	}
	gradient.Rotation = 90
	gradient.Parent = btnFrame
	
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 1, 0)
	button.BackgroundTransparency = 1
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 13
	button.Font = Enum.Font.GothamBold
	button.Parent = btnFrame
	
	local conn = button.MouseButton1Click:Connect(function()
		if callback then callback() end
	end)
	table.insert(connections, conn)
	
	button.MouseEnter:Connect(function()
		TweenService:Create(btnFrame, TweenInfo.new(0.2), 
			{BackgroundColor3 = Color3.fromRGB(180, 80, 255)}):Play()
	end)
	
	button.MouseLeave:Connect(function()
		TweenService:Create(btnFrame, TweenInfo.new(0.2), 
			{BackgroundColor3 = Color3.fromRGB(138, 43, 226)}):Play()
	end)
	
	return btnFrame
end

