-- Function to create a modern button
local function createButton(name, text, position, parent, color)
	local buttonFrame = Instance.new("Frame")
	buttonFrame.Name = name .. "Frame"
	buttonFrame.Size = UDim2.new(0, 280, 0, 55)
	buttonFrame.Position = position
	buttonFrame.BackgroundColor3 = color or Color3.fromRGB(40, 40, 50)
	buttonFrame.BorderSizePixel = 0
	buttonFrame.ZIndex = 3
	buttonFrame.Parent = parent
	
	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 12)
	buttonCorner.Parent = buttonFrame
	
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = UDim2.new(1, 0, 1, 0)
	button.Position = UDim2.new(0, 0, 0, 0)
	button.BackgroundTransparency = 1
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 18
	button.Font = Enum.Font.GothamBold
	button.ZIndex = 4
	button.Parent = buttonFrame
	
	-- Button gradient
	local btnGradient = Instance.new("UIGradient")
	btnGradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(1, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0.7, 0.7, 0.7))
	}
	btnGradient.Rotation = 90
	btnGradient.Parent = buttonFrame
	
	-- Hover effects with smooth animation
	button.MouseEnter:Connect(function()
		game:GetService("TweenService"):Create(
			buttonFrame,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{BackgroundColor3 = Color3.fromRGB(80, 40, 120)}
		):Play()
		game:GetService("TweenService"):Create(
			button,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{TextSize = 20}
		):Play()
	end)
	
	button.MouseLeave:Connect(function()
		game:GetService("TweenService"):Create(
			buttonFrame,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{BackgroundColor3 = color or Color3.fromRGB(40, 40, 50)}
		):Play()
		game:GetService("TweenService"):Create(
			button,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{TextSize = 18}
		):Play()
	end)
	
	return button, buttonFrame
end

-- ESP Functions
local function worldToScreen(position)
	local screenPoint, onScreen = camera:WorldToScreenPoint(position)
	return Vector2.new(screenPoint.X, screenPoint.Y), onScreen, screenPoint.Z
end

local function createESPBox(player)
	if espBoxes[player] then return end
	
	local box = Drawing.new("Square")
	box.Thickness = 2
	box.Color = espColor
	box.Transparency = 1
	box.Filled = false
	box.Visible = false
	
	espBoxes[player] = box
end

local function createTracer(player)
	if espTracers[player] then return end
	
	local tracer = Drawing.new("Line")
	tracer.Thickness = 2
	tracer.Color = tracerColor
	tracer.Transparency = 1
	tracer.Visible = false
	
	espTracers[player] = tracer
end

local function removeESP(player)
	if espBoxes[player] then
		espBoxes[player]:Remove()
		espBoxes[player] = nil
	end
	if espTracers[player] then
		espTracers[player]:Remove()
		espTracers[player] = nil
	end
end

local function updateESP()
	if not espEnabled and not tracersEnabled then return end
	
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player and targetPlayer.Character then
			local character = targetPlayer.Character
			local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChild("Humanoid")
			
			if humanoidRootPart and humanoid and humanoid.Health > 0 then
				local position = humanoidRootPart.Position
				local screenPos, onScreen = worldToScreen(position)
				
				-- Update Tracer
				if tracersEnabled then
					if not espTracers[targetPlayer] then
						createTracer(targetPlayer)
					end
					
					local tracer = espTracers[targetPlayer]
					if onScreen then
						tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
						tracer.To = screenPos
						tracer.Visible = true
					else
						tracer.Visible = false
					end
				elseif espTracers[targetPlayer] then
					espTracers[targetPlayer].Visible = false
				end
				
				-- Update ESP Box
				if espEnabled then
					if not espBoxes[targetPlayer] then
						createESPBox(targetPlayer)
					end
					
					local box = espBoxes[targetPlayer]
					if onScreen then
						local head = character:FindFirstChild("Head")
						if head then
							local headPos = worldToScreen(head.Position + Vector3.new(0, 0.5, 0))
							local legPos = worldToScreen(humanoidRootPart.Position - Vector3.new(0, 3, 0))
							
							local height = math.abs(headPos.Y - legPos.Y)
							local width = height / 2
							
							box.Size = Vector2.new(width, height)
							box.Position = Vector2.new(screenPos.X - width / 2, headPos.Y)
							box.Visible = true
						end
					else
						box.Visible = false
					end
				elseif espBoxes[targetPlayer] then
					espBoxes[targetPlayer].Visible = false
				end
			else
				removeESP(targetPlayer)
			end
		end
	end
end

