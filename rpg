-- Content area with scrolling
local function createTabContent(tabName)
	local scrollFrame = Instance.new("ScrollingFrame")
	scrollFrame.Name = tabName .. "Content"
	scrollFrame.Size = UDim2.new(1, -10, 1, -68)
	scrollFrame.Position = UDim2.new(0, 5, 0, 63)
	scrollFrame.BackgroundTransparency = 1
	scrollFrame.BorderSizePixel = 0
	scrollFrame.ScrollBarThickness = 4
	scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(138, 43, 226)
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	scrollFrame.Visible = (tabName == currentTab)
	scrollFrame.Parent = mainFrame
	
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = scrollFrame
	
	local conn = listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
	end)
	table.insert(connections, conn)
	
	return scrollFrame
end

