-- Kill switch function
local function killSwitch()
	print("🔴 KILL SWITCH ACTIVATED - Removing all script elements...")
	
	-- Disconnect all connections
	for _, conn in ipairs(connections) do
		if conn and conn.Disconnect then
			conn:Disconnect()
		end
	end
	
	-- Remove all ESP
	for targetPlayer, data in pairs(espData) do
		if data and data.folder then
			data.folder:Destroy()
		end
	end
	espData = {}
	
	-- Destroy all created objects
	for _, obj in ipairs(objectsToCleanup) do
		if obj and obj.Parent then
			obj:Destroy()
		end
	end
	
	print("✅ Kill switch complete - Script cleaned up")
end

closeButton.MouseButton1Click:Connect(killSwitch)

